# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.vscode/
package-lock.json
.claude
.vscode

# The example app is committed so it can be cloned and run, and so pub.dev has
# something to show on the Example tab. What the toolchain regenerates is not.
example/pubspec.lock
# Real project credentials for running the example against a live dashboard.
# local.example.json is the committed template.
example/local.json
example/android/local.properties
example/android/.gradle/
example/ios/Flutter/Generated.xcconfig
example/ios/Flutter/flutter_export_environment.sh
example/macos/Flutter/Flutter-Generated.xcconfig
**/Flutter/ephemeral/
**/flutter/ephemeral/
**/Pods/
**/.symlinks/
**/xcuserdata/
# Rewritten by every `flutter pub get` from the current plugin list, so keeping
# it tracked means a clean checkout is dirty the moment anyone resolves — which
# `pub publish` refuses to package.
example/*/flutter/generated_plugins.cmake
